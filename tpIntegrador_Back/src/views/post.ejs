<%- include("partials/head.ejs") %>
<%- include("partials/header.ejs") %>

    <main>
        <section class="form-productos">
            <h2><%= about %></h2>
            
            <form id="postProduct-form" class="form-alta" enctype="multipart/form-data">
                <label for="nameProd">Nombre</label>
                <input type="text" name="name" id="nameProd" required>

                <label for="imageProd">Carátula (Imagen)</label>
                <input type="file" name="image" id="imageProd" accept="image/*" required>

                <label for="categoryProd">Categoria</label>
                <select name="category" id="categoryProd" required>
                    <option value="carreras">carreras</option>
                    <option value="disparos">disparos</option>
                    <option value="aventuras">aventuras</option>
                </select>

                <label for="priceProd">Precio</label>
                <input type="number" name="price" id="priceProd" required>
                
                <div>
                    <input type="submit" value="Crear producto">
                </div>
            </form>
        </section>

        <div class="form-container">
            <h2>Crear usuario</h2>
            
            <form id="postUser-form" class="form-alta">
                <label for="nameUser">Nombre</label>
                <input type="text" name="nameUser" id="nameUser" required>
        
                <label for="emailUser">Email</label>
                <input type="email" name="emailUser" id="emailUser" required>                    
                
                <label for="passUser">Password</label>
                <input type="text" name="passUser" id="passUser" required>
        
                <label for="adminUser">Admin</label>
                <input type="checkbox" name="adminUser" id="adminUser" style="margin-bottom: 15px;">
        
                <div>
                    <input type="submit" value="Crear usuario">
                </div>
            </form>
        </div>

        <hr>
        <section class="secccion-productos">
            <div id="contenedor-productos">
                
            </div>
        </section>
    </main>

    <script src="/js/post.js"></script>
    
<%- include("partials/footer.ejs") %>